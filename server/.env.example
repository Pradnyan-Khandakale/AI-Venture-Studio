# ==============================================================================
# AI VENTURE STUDIO — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT (server/.env)
# ==============================================================================
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-venture-studio
JWT_SECRET=replace-me-with-a-random-secret-for-local-dev

# AI Provider: "gemini" (default) or "ollama"
AI_PROVIDER=gemini

# Google Gemini API (Server-side only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional: GEMINI_MAX_OUTPUT_TOKENS=3500
# Optional: GEMINI_THINKING_BUDGET=0

# Local Ollama Configuration (Local development only — NOT used on Render)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Search Signals & Outbound Email
TAVILY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Venture Studio <reports@localhost>"

# Allowed Frontend Origins for CORS
CLIENT_URL=http://localhost:5173

# ==============================================================================
# 2. PRODUCTION — RENDER (Backend Web Service Environment Variables)
# Set these in Render Dashboard -> Settings -> Environment Variables
# ==============================================================================
# NODE_ENV=production
# PORT=10000
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-venture-studio?retryWrites=true&w=majority
# JWT_SECRET=<generate via: openssl rand -hex 32>
# AI_PROVIDER=gemini
# GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-3.7-flash
# CLIENT_URL=https://<your-vercel-app>.vercel.app
# TAVILY_API_KEY=<your-tavily-api-key>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<your-smtp-email>
# SMTP_PASS=<your-smtp-app-password>
# SMTP_FROM="AI Venture Studio <your-smtp-email>"
