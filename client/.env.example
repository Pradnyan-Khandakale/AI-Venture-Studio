# ==============================================================================
# AI VENTURE STUDIO — CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Local development:
# By default, Vite proxies /api to http://localhost:5000 (no variable needed).
# Or set explicitly:
# VITE_API_URL=http://localhost:5000/api

# Production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://<your-render-service>.onrender.com/api
