PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-venture-studio
JWT_SECRET=replace-me

# AI Provider Selection: "gemini" (default) or "ollama"
AI_PROVIDER=gemini

# Google Gemini API Configuration (Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional: GEMINI_MAX_OUTPUT_TOKENS=3500
# Optional: GEMINI_THINKING_BUDGET=0

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Search & Email Services
TAVILY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Venture Studio <reports@localhost>"
